# Skopiuj ten plik do backend/.env i dostosuj wartości.
# Wszystkie pola są opcjonalne — bez pliku .env backend użyje wartości domyślnych.
# UWAGA: ten plik jest szablonem i trafia do repozytorium — NIE wpisuj tu prawdziwych kluczy.

DATABASE_URL=sqlite:///./data/app.db
SESSION_COOKIE_NAME=mzm_session
SESSION_TTL_HOURS=336
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000

# --- Płatności (Stripe) ---
# Klucz testowy z https://dashboard.stripe.com/test/apikeys (zaczyna się od sk_test_)
# Na produkcji: klucz LIVE (sk_live_...) z tego samego miejsca (przełącz tryb w panelu).
STRIPE_SECRET_KEY=
# Z komendy `stripe listen --forward-to localhost:8000/api/webhooks/stripe` (whsec_...).
# Na produkcji: sekret z endpointu webhooka utworzonego w panelu Stripe (Developers ->
# Webhooks -> Add endpoint -> https://twoja-domena.pl/api/webhooks/stripe).
STRIPE_WEBHOOK_SECRET=
# Zostaw PUSTE — Stripe wtedy samo pokazuje na stronie płatności wszystko, co masz
# włączone w panelu (Dashboard -> Settings -> Payment methods): kartę (razem z Apple Pay
# i Google Pay — te dwa jadą na karcie automatycznie, bez osobnego klucza), BLIK,
# Przelewy24 i inne. Wpisz coś tylko, jeśli chcesz ZAWĘZIĆ listę, np. STRIPE_PAYMENT_METHODS=card,blik,p24
STRIPE_PAYMENT_METHODS=
CURRENCY=pln
# Na produkcji: publiczny adres frontu, np. https://twoja-domena.pl
PUBLIC_BASE_URL=http://localhost:3000

# --- Logowanie dwuetapowe (kod e-mail) ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Logowanie Google (OAuth 2.0) ---
# Z https://console.cloud.google.com/apis/credentials (OAuth client ID, "Web application").
# Puste = przycisk logowania Google wyłączony (backend odpowiada 503).
# Pełna instrukcja: backend/README.md, sekcja "Logowanie Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Zostaw PUSTE — budujemy go z PUBLIC_BASE_URL. Wpisz coś tylko, jeśli backend i front
# naprawdę mają różne publiczne domeny (rzadkie). MUSI być wpisany 1:1 w konsoli Google
# jako "Authorized redirect URI".
GOOGLE_REDIRECT_URI=

# --- Wysyłka e-maili (Resend) ---
# Puste = kody logowania lądują w logach serwera (tryb deweloperski) zamiast
# w prawdziwej skrzynce. Klucz weź z https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Maturalia <onboarding@resend.dev>
SITE_NAME=Maturalia

# --- Panel administracyjny ---
# E-mail(e) (po przecinku) z dostępem do /panel/admin i powiadomień o nowych
# opłaconych zapisach. Puste = panel wyłączony dla wszystkich.
ADMIN_EMAILS=
