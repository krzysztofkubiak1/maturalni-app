# Skopiuj do .env i uzupełnij przed `docker compose up`.
# .env jest w .gitignore — NIE commituj go z prawdziwymi wartościami.

# Domena produkcyjna, BEZ protokołu (bez https://), np. maturalia.pl
# Caddy ogarnie HTTPS automatycznie dla niej i www.{DOMAIN}.
# Do lokalnych testów (docker-compose.dev.yml) wpisz: DOMAIN=localhost
DOMAIN=

# --- PostgreSQL ---
# Backend dostaje DATABASE_URL automatycznie złożony z tych trzech wartości
# (patrz docker-compose.yml) — nie trzeba go wpisywać tutaj osobno.
POSTGRES_USER=maturalia
POSTGRES_PASSWORD=
POSTGRES_DB=maturalia

# --- Backend: sesje ---
# W produkcji (za Caddy, zawsze HTTPS) zostaw true. docker-compose.dev.yml
# nadpisuje to na false do testów lokalnych bez HTTPS.
COOKIE_SECURE=true

# --- Płatności (Stripe) --- patrz backend/README.md, sekcja "Płatności (Stripe)"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Zostaw puste — Stripe pokaże to, co masz włączone w panelu (karta, Apple Pay,
# Google Pay, BLIK, Przelewy24...). Wpisz coś tylko, żeby zawęzić listę.
STRIPE_PAYMENT_METHODS=

# --- E-mail (Resend) --- patrz backend/README.md, sekcja "E-maile (Resend)"
# Puste = e-maile (kody logowania, powiadomienia o rezerwacjach) lądują tylko
# w logach kontenera backendu, nie są realnie wysyłane.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Maturalia <onboarding@resend.dev>

# --- Logowanie Google --- patrz backend/README.md, sekcja "Logowanie Google"
# Authorized redirect URI w konsoli Google: https://TWOJA-DOMENA/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Panel administracyjny ---
# E-mail(e) kont z dostępem do /panel/admin i powiadomień o zapisach, po przecinku.
ADMIN_EMAILS=
